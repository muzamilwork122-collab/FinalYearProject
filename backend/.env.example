# ── App ───────────────────────────────────────────────
APP_NAME=mobile-damage-ai
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/damage_ai

# ── OpenAI (required — powers damage analysis + chat) ──
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ONLY_MODE=true

# Per-task model selection (override without touching code).
# VISION_MODEL analyzes the uploaded screen image — use a strong model
# (e.g. gpt-5, gpt-5.4, gpt-5.5). CHAT_MODEL handles the text-only assistant
# and repair insights, so a cheaper model is fine.
VISION_MODEL=gpt-5
CHAT_MODEL=gpt-4o-mini

# ── Google Sign-In (optional) ─────────────────────────
# OAuth client ID from https://console.cloud.google.com (leave blank to disable)
GOOGLE_CLIENT_ID=

# ── Auth / Admin ──────────────────────────────────────
# Signs stateless auth tokens (override in production).
SECRET_KEY=dev-secret-change-me-in-production
# Default admin-panel credentials (sign in at /admin).
ADMIN_EMAIL=admin@dashboard.com
ADMIN_PASSWORD=Admin@123!

# ── Inference limits ──────────────────────────────────
CONFIDENCE_THRESHOLD=0.5
MAX_IMAGE_SIZE_MB=10
