# ── App ───────────────────────────────────────────────
APP_NAME=mobile-damage-ai
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/damage_ai

# ── OpenAI (required — powers damage analysis + chat) ──
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ONLY_MODE=true

# Per-task model selection (override without touching code).
# Cost-friendly default for image analysis; switch to stronger models only if needed.
VISION_MODEL=gpt-4o-mini
CHAT_MODEL=gpt-4o-mini

# Optional performance/cost controls for /api/predict.
MAIN_INFERENCE_MAX_DIMENSION=1280
MAIN_IMAGE_DETAIL=auto
MAIN_COMPLETION_TOKEN_BUDGET=1200
ENABLE_WALLPAPER_GUARD=true
WALLPAPER_GUARD_MODEL=gpt-4o-mini
WALLPAPER_GUARD_DETAIL=low
WALLPAPER_GUARD_COMPLETION_TOKEN_BUDGET=120
WALLPAPER_GUARD_CONFIDENCE_THRESHOLD=0.80

# ── Google Sign-In (optional) ─────────────────────────
# OAuth client ID from https://console.cloud.google.com (leave blank to disable)
GOOGLE_CLIENT_ID=

# ── Auth / Admin ──────────────────────────────────────
# Signs stateless auth tokens (override in production).
SECRET_KEY=dev-secret-change-me-in-production
# Default admin-panel credentials (sign in at /admin).
ADMIN_EMAIL=admin@dashboard.com
ADMIN_PASSWORD=Admin@123!

# ── Inference limits ──────────────────────────────────
CONFIDENCE_THRESHOLD=0.5
MAX_IMAGE_SIZE_MB=10
